From c3385e8dfc8e2a90bb2c5f8bd3bfe9d9b8d54cf9 Mon Sep 17 00:00:00 2001
From: Jacco <jacco.braat@gmail.com>
Date: Wed, 9 Sep 2026 19:39:44 +0200
Subject: [PATCH] revert fbde868 to fix 88W9098 wireless module
Upstream-Status: Inappropriate [oe specific]

---
 drivers/pci/pci-uclass.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/pci/pci-uclass.c b/drivers/pci/pci-uclass.c
index 83b76d01f24..83e5a461d8a 100644
--- a/drivers/pci/pci-uclass.c
+++ b/drivers/pci/pci-uclass.c
@@ -927,8 +927,10 @@ int pci_bind_bus_devices(struct udevice *bus)
 		if (PCI_FUNC(bdf) && !found_multi)
 			continue;
 
+/* commit fbde868 prevents detection of 88W9098 wireless with 2 radios
 		if (only_one_child(bus) && (PCI_MASK_BUS(bdf) > 0))
 			continue;
+*/
 
 		/* Check only the first access, we don't expect problems */
 		ret = pci_bus_read_config(bus, bdf, PCI_VENDOR_ID, &vendor,
